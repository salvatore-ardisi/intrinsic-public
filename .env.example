# Required - FRED API (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Required - BLS API (free): https://data.bls.gov/registrationEngine/
BLS_API_KEY=your_bls_api_key_here

# Optional - Anthropic API: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set true to enable AI features (requires ANTHROPIC_API_KEY)
ENABLE_AI=false

# Required - Your EDGAR contact info (SEC requires this header)
EDGAR_USER_AGENT=YourAppName your@email.com

# Required - Your Cloudflare Worker proxy URL
PRICE_PROXY_URL=https://your-worker.workers.dev

# Optional - Daily Spark RSS feed URL
SPARK_FEED_URL=
